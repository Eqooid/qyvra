# Qyvra v1.3.0 candidate configuration; AI stays opt-in, credentials server-side.
# Canonical local Compose setup: copy this file to .env and replace POSTGRES_PASSWORD.
# Project name defaults to qyvra in docker-compose.yml; no .env override is needed.
# Existing users: preserve POSTGRES_* and RABBITMQ_USER. Before switching projects,
# map all existing volumes and the broker hostname; see docs/docker-rename.md.
# POSTGRES_VOLUME_NAME=<existing-postgres-volume>
# STORAGE_VOLUME_NAME=<existing-storage-volume>
# RABBITMQ_VOLUME_NAME=<existing-rabbitmq-volume>
# PERSISTENT_VOLUMES_EXTERNAL=true
# RABBITMQ_HOSTNAME=<existing-broker-hostname>
# Compose builds the API DATABASE_URL from POSTGRES_* with URL-encoded credentials.
# Root DATABASE_URL is for host development; it is NOT used inside Compose.
# Only these public settings need adjustment if changing the local Nginx port/origin.
NGINX_PORT=8080
PUBLIC_APP_URL=http://localhost:8080
# HTTP-local cookie policy only; production requires HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false
# Compose uses local storage /data/qyvra, API 3001, web 3000, browser /api/v1.
# No signing secret is needed for the existing opaque PostgreSQL-backed sessions.
# Optional upload values below apply to Compose; remove the # and set real values.
# UPLOAD_MAX_BYTES is also baked into the web image: rebuild when changing it.

# Copy to the repository-root .env and replace placeholders before starting.
# Omit optional entries to use their defaults. Never commit the populated .env.
# Leaving an optional placeholder unchanged will fail startup validation.
# Host API reads root .env; host Prisma CLI requires DATABASE_URL injected separately.
# Compose runs migrations automatically, then starts the complete application.
# Tests ignore .env when NODE_ENV=test is set in the process environment.

# development | test | production; default development.
NODE_ENV=development
# Default QYVRA API; 1-100 characters.
# APP_NAME=<application-name>
# IPv4/IPv6 bind address; default 0.0.0.0. Port default 3001 (1-65535).
# HTTP_HOST=<bind-address>
# PORT=<api-port>
# Maximum JSON body bytes, 1-1048576; default 16384 (16 KiB).
# HTTP_BODY_LIMIT_BYTES=<maximum-json-body-bytes>

# Required in every environment. PostgreSQL URL with host and database name.
# URL-encode credentials supplied locally or through a secret manager.
# No database connection is opened by configuration validation.
# DATABASE_URL=<postgresql-connection-url>
# Connection acquisition/query limits in milliseconds (1-1000); defaults 500.
# DATABASE_CONNECT_TIMEOUT_MS=<connection-timeout-ms>
# DATABASE_QUERY_TIMEOUT_MS=<query-timeout-ms>
# Pool connections per API process (1-20); default 5.
# DATABASE_POOL_SIZE=<pool-size>
# Docker initialization values. These only initialize an empty named volume.
POSTGRES_USER=qyvra
POSTGRES_PASSWORD=<replace-with-a-local-password>
POSTGRES_DB=qyvra
# RabbitMQ uses a distinct production secret. Existing local Compose setups
# fall back to POSTGRES_PASSWORD until this optional value is supplied.
# RABBITMQ_USER=qyvra
# RABBITMQ_PASSWORD=<replace-with-a-different-secret>
# Host-run outbox or worker only; Compose services use rabbitmq:5672.
# RABBITMQ_URL=amqp://<user>:<url-encoded-password>@localhost:5672/
# RABBITMQ_CONNECT_TIMEOUT_MS=5000
# RABBITMQ_CONFIRM_TIMEOUT_MS=10000
# TEST_RABBITMQ_URL=<isolated-test-amqp-url>
# Dispatcher process only: poll interval 1-60000 ms (default 1000),
# batch size 1-100 (default 10), lease 1-3600000 ms (default 120000).
# Lease must exceed RabbitMQ confirm timeout by at least 5000 ms.
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH_SIZE=10
# OUTBOX_LEASE_MS=120000
# Processing retry/recovery coordinator in the outbox process: PostgreSQL-only,
# poll interval 1-60000 ms (default 5000), batch size 1-100 (default 10).
# PROCESSING_RECOVERY_POLL_INTERVAL_MS=5000
# PROCESSING_RECOVERY_BATCH_SIZE=10
# Worker process only: prefetch/concurrency 1-16 (default 2), job lease
# 1-3600000 ms (default 120000), reconnect delay 1-60000 ms (default 1000),
# shutdown drain timeout 1-120000 ms (default 30000).
# WORKER_PREFETCH=2
# WORKER_JOB_LEASE_MS=120000
# WORKER_MEMORY_LIMIT=2g
# PDF extraction: defaults inherit upload byte/page limits. Timeout <= 75% of lease.
# PDF_EXTRACTION_MAX_BYTES=52428800
# PDF_EXTRACTION_MAX_PAGES=500
# PDF_EXTRACTION_MAX_CHARACTERS=5000000
# PDF_EXTRACTION_MAX_TEXT_BYTES=20000000
# PDF_EXTRACTION_TIMEOUT_MS=30000
# PDF_EXTRACTION_HEAP_MB=256
# Deterministic chunk defaults are snapshotted into each AI run (no upload scheduling yet).
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64
# CHUNK_MAX_COUNT=10000
# CHUNK_MAX_OUTPUT_BYTES=40000000
# CHUNK_TIMEOUT_MS=30000
# WORKER_RECONNECT_DELAY_MS=1000
# WORKER_SHUTDOWN_TIMEOUT_MS=30000
# POSTGRES_PORT=<host-port>
# docker-compose.dev.yml publishes this port for a host-run API only.
# Optional test command input, never a real committed credential:
# TEST_DATABASE_URL=<isolated-test-postgresql-url>

# T06 embeddings: disabled until a persisted profile is explicitly configured.
# Endpoint is the full embeddings POST URL; no credentials/query/fragment in URLs.
AI_INGESTION_ENABLED=false
# Provision the immutable SQL profile first. Must match the worker fingerprint.
AI_INGESTION_PROFILE_FINGERPRINT=
EMBEDDING_ENABLED=false
# EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
# EMBEDDING_PROFILE_FINGERPRINT=<immutable-profile-sha256>
# EMBEDDING_API_KEY=<private-provider-key>
# Private local HTTP endpoints require explicit opt-in; protect with network policy.
# EMBEDDING_ALLOW_HTTP=false
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_INPUT_TOKENS=8191
EMBEDDING_MAX_BATCH_TOKENS=100000
EMBEDDING_TIMEOUT_MS=30000
# Disable for models without dimensions request support; responses must still match.
EMBEDDING_SEND_DIMENSIONS=true

# Shared private storage. Provider defaults to local; other providers fail validation.
STORAGE_PROVIDER=local
# Required absolute dedicated directory OUTSIDE the repository for a host-run API.
# For containers Compose overrides this to /data/qyvra on the storage_data volume.
# LOCAL_STORAGE_ROOT=<absolute-private-storage-directory>
# Optional upload settings: omit to use defaults. These do not enable processing.
# Maximum file bytes: default 52428800 (50 MiB), maximum 209715200 (200 MiB).
# UPLOAD_MAX_BYTES=<maximum-file-bytes>
# PDF page count default 500, maximum 2000; image pixels default 40000000, max 100000000.
# UPLOAD_MAX_PAGES=<maximum-pdf-pages>
# UPLOAD_MAX_PIXELS=<maximum-image-pixels>
# Receive timeout default 120000 ms; each PDF inspection command default 15000 ms.
# UPLOAD_TIMEOUT_MS=<upload-timeout-ms>
# UPLOAD_INSPECTION_TIMEOUT_MS=<inspection-timeout-ms>
# Simultaneous receiving/inspecting uploads per API process: default 2, maximum 8.
# UPLOAD_CONCURRENCY=<concurrent-uploads>
# Default qpdf from PATH. Container installs qpdf; host users must install it.
# UPLOAD_QPDF_PATH=<qpdf-executable-path>

# Comma-separated exact HTTP(S) origins; blank or omitted disables CORS.
# No paths, trailing slashes, credentials, or wildcards. Production requires HTTPS.
# CORS_ORIGINS=<frontend-origin-list>
# true | false; default false.
# CORS_CREDENTIALS=<true-or-false>

# Password Unicode code-point lengths: minimum 15-128 (default 15),
# maximum 64-1024 (default 128), maximum must be >= minimum.
# Passwords are not trimmed or normalized; whitespace-only passwords are rejected.
# AUTH_PASSWORD_MIN_LENGTH=<minimum-password-length>
# AUTH_PASSWORD_MAX_LENGTH=<maximum-password-length>

# Session lifetime in seconds: 1-2592000; default 604800 (7 days).
# AUTH_SESSION_TTL_SECONDS=<session-lifetime-seconds>
# Refresh lifetime: 1-7776000 seconds, default 2592000; at least session lifetime.
# AUTH_REFRESH_TTL_SECONDS=<refresh-lifetime-seconds>
# Login attempts per window: 1-100; default 5.
# AUTH_LOGIN_MAX_ATTEMPTS=<maximum-login-attempts>
# Login window in seconds: 1-86400; default 900.
# AUTH_LOGIN_WINDOW_SECONDS=<login-window-seconds>
# Temporary lockout duration: 1-86400 seconds; default 900.
# AUTH_LOGIN_LOCKOUT_SECONDS=<login-lockout-seconds>

# Per-process fixed-window throttling, counted before parsing/hashing.
# Window 1-3600 seconds, default 60. Per-peer, per-endpoint limits 1-1000.
# AUTH_RATE_WINDOW_SECONDS=<rate-window-seconds>
# AUTH_REGISTER_RATE_LIMIT=<registration-request-limit>
# AUTH_LOGIN_RATE_LIMIT=<login-request-limit>
# AUTH_REFRESH_RATE_LIMIT=<refresh-request-limit>
# Defaults: registration 10, login 30, refresh 60 requests per window.
# Combined budget across all peers and these endpoints: 1-10000, default 300.
# AUTH_GLOBAL_RATE_LIMIT=<combined-request-limit>
# Forwarding headers are not trusted. Behind a proxy, callers share its budget.

# 1-64 letters/digits/underscores/hyphens; default document_tracker_session.
# COOKIE_NAME=<session-cookie-name>
# Distinct refresh cookie name; default document_tracker_refresh.
# COOKIE_REFRESH_NAME=<refresh-cookie-name>
# Optional lowercase DNS domain. Omit for host-only cookies (recommended).
# COOKIE_DOMAIN=<cookie-domain>
# Session scope: / (default), /api, or /api/v1.
# COOKIE_PATH=<session-cookie-path>
# Refresh scope: /api/v1/auth (default), /, /api, or /api/v1.
# COOKIE_REFRESH_PATH=<refresh-cookie-path>
# __Host- names require Path=/ and no COOKIE_DOMAIN for that cookie.
# true | false; defaults true in production and false otherwise.
# Must be true in production, with SameSite=none, or __Host-/__Secure- names.
# COOKIE_SECURE=<true-or-false>
# lax | strict | none; default lax.
# COOKIE_SAME_SITE=<same-site-policy>
# HttpOnly=true is fixed. Max-age and Expires derive from database expiration.
# Browser login Origin must be listed in CORS_ORIGINS, including same-origin UI.
# Cross-origin browser clients also need CORS_CREDENTIALS=true and credentials: include.
# Allowed origins can read Retry-After on 429 responses; rate limits remain per process.
# A blank CORS_ORIGINS disables browser cross-origin access, not server-side Origin checks.
# Refresh/logout additionally require the X-CSRF-Protection: 1 request header.
# Opaque server-side sessions do not require a JWT signing secret.

# Optional disposable processing progress. API and worker continue without Redis.
# Optional derived vector index: worker writes; enabled search/RAG API reads.
# Collections follow the fixed v1 profile strategy; credentials stay server-side.
VECTOR_INDEX_ENABLED=false
# Host-run: http://127.0.0.1:6333; Compose defaults to private http://qdrant:6333.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=replace-with-a-private-service-key
# Production requires HTTPS unless the private network explicitly allows HTTP.
QDRANT_ALLOW_HTTP=false
QDRANT_TIMEOUT_MS=10000
VECTOR_INDEX_BATCH_SIZE=64
# QDRANT_VOLUME_NAME=qyvra_qdrant_data
# Only set true when reusing a Qdrant volume that already exists.
# Independent of legacy PostgreSQL/storage/RabbitMQ external-volume protection.
QDRANT_VOLUME_EXTERNAL=false
# Host-run development: redis://127.0.0.1:6379. Compose injects redis://redis:6379.
# REDIS_URL=redis://127.0.0.1:6379
# PROCESSING_PROGRESS_TTL_SECONDS=180
# REDIS_CONNECT_TIMEOUT_MS=500
# REDIS_COMMAND_TIMEOUT_MS=500
# REDIS_PORT=6379  # dev Compose host-only port
# Interactive semantic retrieval; requires enabled embedding/vector adapters plus
# an explicitly selected PostgreSQL AiServingProfile row. Never selects automatically.
SEMANTIC_SEARCH_ENABLED=false
# Optional API-only override for serving an existing profile while workers build a new one.
SEMANTIC_SEARCH_PROFILE_FINGERPRINT=
# Optional calibrated threshold for EMBEDDING_PROFILE_FINGERPRINT only; no universal default.
SEMANTIC_SEARCH_MIN_SCORE=
SEMANTIC_SEARCH_MAX_MANIFESTS=250
SEMANTIC_SEARCH_TIMEOUT_MS=35000
SEMANTIC_SEARCH_CONCURRENCY=4
SEMANTIC_SEARCH_USER_PER_MINUTE=30
SEMANTIC_SEARCH_GLOBAL_PER_MINUTE=300

# Standalone grounded answers. Requires semantic search plus a calibrated score.
# Generation is independent of embeddings; endpoint is the FULL chat/completions URL.
RAG_ENABLED=false
RAG_MAX_SOURCES=8
RAG_PER_DOCUMENT_SOURCES=3
# Total declared model window: input/schema/envelope reserve + maximum output.
RAG_CONTEXT_TOKENS=8192
RAG_TIMEOUT_MS=60000
RAG_CONCURRENCY=2
RAG_USER_PER_MINUTE=10
RAG_GLOBAL_PER_MINUTE=100
GENERATION_PROVIDER=openai-compatible
GENERATION_MODEL=
GENERATION_ENDPOINT=
GENERATION_API_KEY=
GENERATION_ALLOW_HTTP=false
# Must match model tokenization; cl100k_base is also supported, independently of embeddings.
GENERATION_TOKENIZER=o200k_base
GENERATION_TIMEOUT_MS=25000
GENERATION_MAX_OUTPUT_TOKENS=1024
GENERATION_TEMPERATURE=0
# Use max_tokens only for compatible deployments that require the legacy field.
GENERATION_OUTPUT_TOKEN_FIELD=max_completion_tokens
