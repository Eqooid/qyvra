# Docker DNS is resolved at request time, so replacing api/web containers needs no proxy restart.
server {
    listen 80;
    server_name _;
    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream api:3001;
    set $web_upstream web:3000;
    client_max_body_size ${NGINX_MAX_BODY_BYTES};
    client_body_timeout 650s;
    send_timeout 650s;

    # Avoid recording document query text, cookies or credentials in proxy access logs.
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 650s;
    proxy_send_timeout 650s;

    location /api/ {
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        # Explicit original URI preserves /api/v1, query strings and encoded paths.
        proxy_pass http://$api_upstream$request_uri;
    }
    location / {
        proxy_buffering off;
        proxy_pass http://$web_upstream$request_uri;
    }
}
