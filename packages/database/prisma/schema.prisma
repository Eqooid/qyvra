generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum IdentityProvider {
  LOCAL
  KEYCLOAK
  OIDC

  @@map("identity_provider")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @unique @db.VarChar(320)
  displayName String?   @map("display_name") @db.VarChar(100)
  locale      String    @default("en") @db.VarChar(35)
  timezone    String    @default("UTC") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  identities       UserIdentity[]
  localCredentials LocalCredential?
  sessions         AuthSession[]
  categories       Category[]
  tags             Tag[]
  documents        Document[]
  uploads          DocumentUpload[]

  @@map("users")
}

// Case-insensitive owner/name uniqueness is enforced by a custom SQL expression index.
model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  documents DocumentTag[]

  @@unique([id, userId])
  @@index([userId, id])
  @@map("tags")
}

// Case-insensitive owner/name uniqueness is enforced by a custom SQL expression index.
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(7)
  icon      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  documents Document[]

  @@unique([id, userId])
  @@index([userId, id])
  @@map("categories")
}

model UserIdentity {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  provider  IdentityProvider
  issuer    String           @db.VarChar(2048)
  subject   String           @db.VarChar(255)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, issuer, subject])
  @@index([userId])
  @@map("user_identities")
}

model LocalCredential {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  passwordHash        String    @map("password_hash")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz(3)
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("local_credentials")
}

model AuthSession {
  consumedRefreshTokens ConsumedRefreshToken[]
  authenticationMethod  String                 @default("LOCAL_PASSWORD") @map("authentication_method") @db.VarChar(32)
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  tokenHash             String                 @unique @map("token_hash") @db.VarChar(64)
  refreshTokenHash      String?                @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt             DateTime               @map("expires_at") @db.Timestamptz(3)
  refreshExpiresAt      DateTime?              @map("refresh_expires_at") @db.Timestamptz(3)
  revokedAt             DateTime?              @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt            DateTime?              @map("last_seen_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

model ConsumedRefreshToken {
  tokenHash  String      @id @map("token_hash") @db.VarChar(64)
  sessionId  String      @map("session_id") @db.Uuid
  consumedAt DateTime    @default(now()) @map("consumed_at") @db.Timestamptz(3)
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([sessionId])
  @@map("consumed_refresh_tokens")
}

model Document {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  categoryId      String?           @map("category_id") @db.Uuid
  title           String            @db.VarChar(300)
  description     String?           @db.VarChar(2000)
  documentType    String            @default("OTHER") @map("document_type") @db.VarChar(50)
  status          String            @default("UPLOADED") @db.VarChar(32)
  issuer          String?           @db.VarChar(200)
  referenceNumber String?           @map("reference_number") @db.VarChar(200)
  documentDate    DateTime?         @map("document_date") @db.Date
  expirationDate  DateTime?         @map("expiration_date") @db.Date
  verifiedSummary String?           @map("verified_summary") @db.VarChar(10000)
  isArchived      Boolean           @default(false) @map("is_archived")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(3)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category        Category?         @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  tags            DocumentTag[]
  versions        DocumentVersion[]
  processingJobs  ProcessingJob[]

  @@unique([id, userId])
  @@index([userId, createdAt, id])
  @@index([userId, status, documentDate])
  @@index([userId, categoryId])
  @@map("documents")
}

model DocumentTag {
  documentId String   @map("document_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  document   Document @relation(fields: [documentId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  tag        Tag      @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([documentId, tagId])
  @@index([userId, tagId, documentId])
  @@map("document_tags")
}

model DocumentVersion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String          @map("document_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  versionNumber    Int             @map("version_number")
  originalFilename String          @map("original_filename") @db.VarChar(255)
  storageKey       String          @unique @map("storage_key") @db.VarChar(512)
  mimeType         String          @map("mime_type") @db.VarChar(100)
  fileSize         Int             @map("file_size")
  checksumSha256   String          @map("checksum_sha256") @db.VarChar(64)
  pageCount        Int?            @map("page_count")
  extractionStatus String          @default("PENDING") @map("extraction_status") @db.VarChar(32)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  document         Document        @relation(fields: [documentId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  processingJobs   ProcessingJob[]

  aiRuns          AiProcessingRun[]
  extractedTexts  ExtractedText[]
  chunkSets       ChunkSet[]
  chunks          DocumentChunk[]
  chunkEmbeddings ChunkEmbedding[]
  vectorIndexes   VersionVectorIndex[]
  aiState         VersionAiState?
  readyIndexes    VersionReadyIndex[]

  @@unique([id, documentId, userId])
  @@unique([documentId, versionNumber])
  @@unique([userId, checksumSha256])
  @@index([checksumSha256])
  @@index([documentId, createdAt, id])
  @@map("document_versions")
}

model DocumentUpload {
  userId      String   @map("user_id") @db.Uuid
  scope       String   @default("create") @db.VarChar(64)
  key         String   @db.Uuid
  attemptId   String   @map("attempt_id") @db.Uuid
  state       String   @default("RECEIVING") @db.VarChar(16)
  fingerprint String?  @db.VarChar(64)
  documentId  String?  @map("document_id") @db.Uuid
  response    Json?
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, scope, key])
  @@index([expiresAt])
  @@map("document_uploads")
}

// Status/type checks and the one-active-job-per-version/type index live in SQL.
model ProcessingJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  documentVersionId String    @map("document_version_id") @db.Uuid
  jobType           String    @map("job_type") @db.VarChar(64)
  generation        Int       @default(1)
  status            String    @default("PENDING") @db.VarChar(16)
  attempts          Int       @default(0)
  maxAttempts       Int       @map("max_attempts")
  availableAt       DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken        String?   @map("lease_token") @db.Uuid
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  heartbeatAt       DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  lastFailureCode   String?   @map("last_failure_code") @db.VarChar(64)
  correlationId     String    @map("correlation_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  aiRunId          String? @map("ai_run_id") @db.Uuid
  predecessorJobId String? @map("predecessor_job_id") @db.Uuid
  extractedTextId  String? @map("extracted_text_id") @db.Uuid
  chunkSetId       String? @map("chunk_set_id") @db.Uuid
  vectorIndexId    String? @map("vector_index_id") @db.Uuid

  aiRun            AiProcessingRun?    @relation(fields: [aiRunId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  predecessor      ProcessingJob?      @relation("JobDependency", fields: [predecessorJobId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  successors       ProcessingJob[]     @relation("JobDependency")
  extraction       ExtractedText?      @relation(fields: [extractedTextId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  chunkSet         ChunkSet?           @relation(fields: [chunkSetId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  vectorIndex      VersionVectorIndex? @relation(fields: [vectorIndexId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  extractionStates VersionAiState[]    @relation("LastExtraction")

  document Document           @relation(fields: [documentId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  version  DocumentVersion    @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  outbox   ProcessingOutbox[]

  @@unique([documentVersionId, jobType, generation])
  @@unique([id, documentVersionId, documentId, userId], map: "processing_jobs_owned_identity_key")
  @@index([aiRunId, jobType], map: "processing_jobs_run_type_idx")
  @@index([predecessorJobId], map: "processing_jobs_predecessor_idx")
  @@index([userId, documentId, documentVersionId, createdAt], map: "processing_jobs_owner_version_created_idx")
  @@index([status, availableAt, id])
  @@index([status, leaseExpiresAt])
  @@map("processing_jobs")
}

model ProcessingOutbox {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processingJobId     String    @map("processing_job_id") @db.Uuid
  eventType           String    @map("event_type") @db.VarChar(64)
  schemaVersion       Int       @map("schema_version")
  dispatchSequence    Int       @map("dispatch_sequence")
  payload             Json
  status              String    @default("PENDING") @db.VarChar(16)
  publicationAttempts Int       @default(0) @map("publication_attempts")
  availableAt         DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  claimToken          String?   @map("claim_token") @db.Uuid
  claimExpiresAt      DateTime? @map("claim_expires_at") @db.Timestamptz(3)
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(3)
  lastFailureCode     String?   @map("last_failure_code") @db.VarChar(64)
  occurredAt          DateTime  @map("occurred_at") @db.Timestamptz(3)
  correlationId       String    @map("correlation_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  job ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([processingJobId, eventType, dispatchSequence], map: "processing_outbox_job_type_sequence_key")
  @@index([status, availableAt, id])
  @@index([status, claimExpiresAt])
  @@map("processing_outbox")
}

// AI models are persistence only. Custom checks, immutable artifacts and partial
// uniqueness are implemented by the Phase 4 SQL migration.
model EmbeddingProfile {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fingerprint          String               @unique @db.VarChar(64)
  profileVersion       Int                  @map("profile_version")
  provider             String               @db.VarChar(100)
  model                String               @db.VarChar(200)
  modelRevision        String               @map("model_revision") @db.VarChar(200)
  dimensions           Int
  distance             String               @default("Cosine") @db.VarChar(16)
  normalizationVersion String               @map("normalization_version") @db.VarChar(100)
  tokenizer            String               @db.VarChar(100)
  tokenizerVersion     String               @map("tokenizer_version") @db.VarChar(100)
  documentInstruction  String               @default("") @map("document_instruction") @db.VarChar(2000)
  queryInstruction     String               @default("") @map("query_instruction") @db.VarChar(2000)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  runs                 AiProcessingRun[]
  embeddings           ChunkEmbedding[]
  indexes              VersionVectorIndex[]
  readyIndexes         VersionReadyIndex[]
  serving              AiServingProfile?

  @@unique([id, dimensions])
  @@map("embedding_profiles")
}

model AiProcessingRun {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                  @map("user_id") @db.Uuid
  documentId            String                  @map("document_id") @db.Uuid
  documentVersionId     String                  @map("document_version_id") @db.Uuid
  generation            Int
  status                String                  @default("BUILDING") @db.VarChar(16)
  extractor             String                  @db.VarChar(100)
  extractorVersion      String                  @map("extractor_version") @db.VarChar(100)
  normalizationVersion  String                  @map("normalization_version") @db.VarChar(100)
  chunkAlgorithm        String                  @map("chunk_algorithm") @db.VarChar(100)
  chunkAlgorithmVersion String                  @map("chunk_algorithm_version") @db.VarChar(100)
  tokenizer             String                  @db.VarChar(100)
  tokenizerVersion      String                  @map("tokenizer_version") @db.VarChar(100)
  chunkSize             Int                     @map("chunk_size")
  chunkOverlap          Int                     @map("chunk_overlap")
  embeddingProfileId    String                  @map("embedding_profile_id") @db.Uuid
  lastFailureCode       String?                 @map("last_failure_code") @db.VarChar(64)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt           DateTime?               @map("completed_at") @db.Timestamptz(3)
  version               DocumentVersion         @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  profile               EmbeddingProfile        @relation(fields: [embeddingProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  jobs                  ProcessingJob[]
  indexes               VersionVectorIndex[]
  desiredStates         VersionAiState[]
  reprocessingRequests  AiReprocessingRequest[]

  @@unique([documentVersionId, generation])
  @@unique([id, documentVersionId, documentId, userId], map: "ai_runs_owned_identity_key")
  @@unique([id, embeddingProfileId], map: "ai_runs_profile_key")
  @@index([userId, documentId, documentVersionId, createdAt], map: "ai_runs_owner_version_idx")
  @@index([status, updatedAt, id])
  @@map("ai_processing_runs")
}

model ExtractedText {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  documentId            String          @map("document_id") @db.Uuid
  documentVersionId     String          @map("document_version_id") @db.Uuid
  extractionFingerprint String          @map("extraction_fingerprint") @db.VarChar(64)
  extractor             String          @db.VarChar(100)
  extractorVersion      String          @map("extractor_version") @db.VarChar(100)
  normalizationVersion  String          @map("normalization_version") @db.VarChar(100)
  sourceChecksum        String          @map("source_checksum") @db.VarChar(64)
  contentHash           String          @map("content_hash") @db.VarChar(64)
  text                  String          @db.Text
  pageSpans             Json            @map("page_spans") @db.JsonB
  characterCount        Int             @map("character_count")
  pageCount             Int             @map("page_count")
  outcome               String          @default("COMPLETED") @db.VarChar(16)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  version               DocumentVersion @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  chunkSets             ChunkSet[]
  jobs                  ProcessingJob[]

  @@unique([documentVersionId, extractionFingerprint], map: "extracted_texts_version_fingerprint_key")
  @@unique([id, documentVersionId, documentId, userId], map: "extracted_texts_owned_identity_key")
  @@index([userId, documentId, documentVersionId], map: "extracted_texts_owner_version_idx")
  @@map("extracted_texts")
}

model ChunkSet {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  documentId        String               @map("document_id") @db.Uuid
  documentVersionId String               @map("document_version_id") @db.Uuid
  extractedTextId   String               @map("extracted_text_id") @db.Uuid
  extractionHash    String               @map("extraction_hash") @db.VarChar(64)
  fingerprint       String               @db.VarChar(64)
  algorithm         String               @db.VarChar(100)
  algorithmVersion  String               @map("algorithm_version") @db.VarChar(100)
  tokenizer         String               @db.VarChar(100)
  tokenizerVersion  String               @map("tokenizer_version") @db.VarChar(100)
  chunkSize         Int                  @map("chunk_size")
  chunkOverlap      Int                  @map("chunk_overlap")
  chunkCount        Int                  @default(0) @map("chunk_count")
  complete          Boolean              @default(false)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  version           DocumentVersion      @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  extraction        ExtractedText        @relation(fields: [extractedTextId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  chunks            DocumentChunk[]
  indexes           VersionVectorIndex[]
  jobs              ProcessingJob[]

  @@unique([documentVersionId, fingerprint])
  @@unique([id, documentVersionId, documentId, userId], map: "chunk_sets_owned_identity_key")
  @@index([userId, documentId, documentVersionId], map: "chunk_sets_owner_version_idx")
  @@map("chunk_sets")
}

model DocumentChunk {
  // Assigned by the deterministic UUIDv5 chunker; never generated by Qdrant.
  id                String           @id @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  documentId        String           @map("document_id") @db.Uuid
  documentVersionId String           @map("document_version_id") @db.Uuid
  chunkSetId        String           @map("chunk_set_id") @db.Uuid
  ordinal           Int
  text              String           @db.Text
  textHash          String           @map("text_hash") @db.VarChar(64)
  startOffset       Int              @map("start_offset")
  endOffset         Int              @map("end_offset")
  tokenCount        Int              @map("token_count")
  pageSpans         Json             @map("page_spans") @db.JsonB
  sectionLabel      String?          @map("section_label") @db.VarChar(300)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  version           DocumentVersion  @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  set               ChunkSet         @relation(fields: [chunkSetId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  embeddings        ChunkEmbedding[]

  @@unique([chunkSetId, ordinal])
  @@unique([id, documentVersionId, documentId, userId], map: "document_chunks_owned_identity_key")
  @@index([userId, documentId, documentVersionId], map: "document_chunks_owner_version_idx")
  @@map("document_chunks")
}

model ChunkEmbedding {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  documentId         String           @map("document_id") @db.Uuid
  documentVersionId  String           @map("document_version_id") @db.Uuid
  chunkId            String           @map("chunk_id") @db.Uuid
  embeddingProfileId String           @map("embedding_profile_id") @db.Uuid
  dimensions         Int
  inputHash          String           @map("input_hash") @db.VarChar(64)
  vector             Float[]          @db.DoublePrecision
  completedAt        DateTime         @default(now()) @map("completed_at") @db.Timestamptz(3)
  version            DocumentVersion  @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  chunk              DocumentChunk    @relation(fields: [chunkId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  profile            EmbeddingProfile @relation(fields: [embeddingProfileId, dimensions], references: [id, dimensions], onDelete: Restrict, onUpdate: Restrict)

  @@unique([chunkId, embeddingProfileId])
  @@index([userId, documentId, documentVersionId, embeddingProfileId], map: "chunk_embeddings_owner_profile_idx")
  @@map("chunk_embeddings")
}

model VersionVectorIndex {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  documentId           String              @map("document_id") @db.Uuid
  documentVersionId    String              @map("document_version_id") @db.Uuid
  aiRunId              String              @map("ai_run_id") @db.Uuid
  chunkSetId           String              @map("chunk_set_id") @db.Uuid
  embeddingProfileId   String              @map("embedding_profile_id") @db.Uuid
  collectionGeneration Int                 @map("collection_generation")
  collectionName       String              @map("collection_name") @db.VarChar(200)
  expectedPointCount   Int                 @map("expected_point_count")
  confirmedPointCount  Int                 @default(0) @map("confirmed_point_count")
  checkpointOrdinal    Int                 @default(-1) @map("checkpoint_ordinal")
  status               String              @default("BUILDING") @db.VarChar(32)
  lastFailureCode      String?             @map("last_failure_code") @db.VarChar(64)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  indexedAt            DateTime?           @map("indexed_at") @db.Timestamptz(3)
  version              DocumentVersion     @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  run                  AiProcessingRun     @relation(fields: [aiRunId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  set                  ChunkSet            @relation(fields: [chunkSetId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  profile              EmbeddingProfile    @relation(fields: [embeddingProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  readyMappings        VersionReadyIndex[]
  jobs                 ProcessingJob[]

  @@unique([aiRunId, collectionGeneration])
  @@unique([id, documentVersionId, documentId, userId], map: "vector_indexes_owned_identity_key")
  @@unique([id, embeddingProfileId], map: "vector_indexes_profile_key")
  @@index([userId, documentId, documentVersionId, embeddingProfileId, status], map: "vector_indexes_owner_profile_idx")
  @@index([status, updatedAt, id], map: "vector_indexes_reconciliation_idx")
  @@map("version_vector_indexes")
}

model VersionAiState {
  documentVersionId   String           @id @map("document_version_id") @db.Uuid
  documentId          String           @map("document_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  desiredRunId        String?          @map("desired_run_id") @db.Uuid
  lastExtractionJobId String?          @map("last_extraction_job_id") @db.Uuid
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version             DocumentVersion  @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  desiredRun          AiProcessingRun? @relation(fields: [desiredRunId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)
  lastExtractionJob   ProcessingJob?   @relation("LastExtraction", fields: [lastExtractionJobId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)

  @@unique([documentVersionId, documentId, userId], map: "version_ai_states_owned_identity_key")
  @@index([userId, documentId], map: "version_ai_states_owner_idx")
  @@map("version_ai_states")
}

model VersionReadyIndex {
  documentVersionId  String             @map("document_version_id") @db.Uuid
  documentId         String             @map("document_id") @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  embeddingProfileId String             @map("embedding_profile_id") @db.Uuid
  vectorIndexId      String             @unique @map("vector_index_id") @db.Uuid
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  version            DocumentVersion    @relation(fields: [documentVersionId, documentId, userId], references: [id, documentId, userId], onDelete: Cascade, onUpdate: Restrict)
  profile            EmbeddingProfile   @relation(fields: [embeddingProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  index              VersionVectorIndex @relation(fields: [vectorIndexId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: NoAction, onUpdate: Restrict)

  @@id([documentVersionId, embeddingProfileId])
  @@index([userId, embeddingProfileId, documentId], map: "version_ready_indexes_owner_profile_idx")
  @@map("version_ready_indexes")
}

model AiReprocessingRequest {
  documentVersionId String          @map("document_version_id") @db.Uuid
  documentId        String          @map("document_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  key               String          @db.Uuid
  mode              String          @db.VarChar(16)
  runId             String          @map("run_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  run               AiProcessingRun @relation(fields: [runId, documentVersionId, documentId, userId], references: [id, documentVersionId, documentId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@id([documentVersionId, key])
  @@index([runId])
  @@map("ai_reprocessing_requests")
}

model AiServingProfile {
  // SQL CHECK enforces id=1. No row means AI serving is unconfigured.
  id                 Int              @id @default(1)
  embeddingProfileId String           @unique @map("embedding_profile_id") @db.Uuid
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile            EmbeddingProfile @relation(fields: [embeddingProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ai_serving_profile")
}
