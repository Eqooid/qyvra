{
  "name": "@qyvra/database",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint src --ext .ts prisma.config.ts",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prisma format && prettier --write \"src/*.ts\" prisma.config.ts package.json tsconfig.json .eslintrc.cjs",
    "format:check": "prisma format --check && prettier --check \"src/*.ts\" prisma.config.ts package.json tsconfig.json .eslintrc.cjs",
    "migrate:deploy": "prisma migrate deploy",
    "test:migration": "node --test test/description-migration.test.cjs",
    "test:ai": "node --test test/ai-contracts.test.cjs test/ai-persistence.test.cjs",
    "test:pipeline": "node --test --test-concurrency=1 test/processing-pipeline.test.cjs test/processing-repository.test.cjs test/processing-persistence.test.cjs test/processing-rules.test.cjs",
    "test:ai:migration": "node --test test/ai-migration.test.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.16.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.5",
    "fast-uri": "3.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "prettier": "^3.0.0",
    "prisma": "^7.0.0",
    "typescript": "^5.9.0"
  }
}
