# Copy to apps/web/.env.local. Next.js does not load the repository-root .env.
# Public browser API URL only, never credentials. Include /api/v1, not /docs.
# Local example: http://localhost:3002/api/v1
NEXT_PUBLIC_API_BASE_URL=<public-api-base-url>
# Omit for /api/v1 only when a same-origin reverse proxy routes it to NestJS.
# This value is embedded at build time: rebuild after production URL changes.
# Optional public UX size limit; omit for 50 MiB. Match the API UPLOAD_MAX_BYTES.
# NEXT_PUBLIC_UPLOAD_MAX_BYTES=<maximum-file-size-in-bytes>
