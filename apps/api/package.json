{
  "name": "@brainless/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "database:build": "npm --prefix ../../packages/database run build",
    "database:generate": "npm --prefix ../../packages/database run generate",
    "prestart": "npm run shared:build",
    "prestart:dev": "npm run shared:build",
    "prestart:debug": "npm run shared:build",
    "prebuild": "npm run shared:build",
    "pretypecheck": "npm run shared:build",
    "pretest": "npm run shared:build",
    "pretest:e2e": "npm run shared:build",
    "pretest:integration": "npm run shared:build",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:outbox": "node dist/outbox-main.js",
    "start:worker": "node dist/worker-main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "storage:build": "npm --prefix ../../packages/storage run build",
    "shared:build": "npm run storage:build && npm run database:build"
  },
  "dependencies": {
    "@brainless/database": "file:../../packages/database",
    "@brainless/storage": "file:../../packages/storage",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "amqplib": "^2.0.1",
    "argon2": "^0.44.0",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    },
    "js-yaml@4.1.0": "4.3.2",
    "qs": "6.16.0",
    "body-parser@1.20.4": "1.20.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
